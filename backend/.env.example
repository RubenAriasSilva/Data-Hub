PORT=4000
# 0.0.0.0 permite el acceso desde otras computadoras de la red; 127.0.0.1 solo local
HOST=0.0.0.0

# Conexión MySQL 8 (la base de datos se crea automáticamente si no existe)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=data_hub

# MongoDB (opcional). Vacío = solo MySQL; con valor, al crear una tabla se puede elegir MongoDB.
# Ej.: mongodb://127.0.0.1:27017  o  mongodb://usuario:clave@servidor:27017/?authSource=admin
MONGO_URI=
MONGO_DB=data_hub

# Tamaño máximo de archivo Excel en MB
MAX_UPLOAD_MB=20
